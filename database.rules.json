{
  "rules": {
    "test": { ".read": true, ".write": true },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['profile'])",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'provider']) && newData.child('name').isString() && newData.child('email').isString() && newData.child('provider').isString()"
        },
        "favorites": {
          ".validate": "newData.isArray()"
        }
      }
    }
  }
}
