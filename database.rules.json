{
  "rules": {
    "test": { ".read": true, ".write": true },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'provider']) && newData.child('name').isString() && newData.child('email').isString() && newData.child('provider').isString()"
        },
        "favorites": {
          ".validate": true
        }
      }
    },
    "certifications": {
      ".indexOn": ["status", "submittedAt", "email"],
      "$submissionId": {
        ".read": "auth != null && (auth.token.email === 'zoyabilal01@gmail.com' || root.hasChild('certificationAdmins/' + auth.uid))",
        ".write": "true"
      }
    }
  }
}
